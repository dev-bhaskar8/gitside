$ErrorActionPreference = 'Stop'

$packageArgs = @{
  packageName    = 'gitside'
  unzipLocation  = Split-Path -Parent $MyInvocation.MyCommand.Definition
  url64bit       = 'https://github.com/dev-bhaskar8/gitside/releases/download/v__VERSION__/gitside-x86_64-pc-windows-msvc.zip'
  checksum64     = '__X64_ZIP_SHA256__'
  checksumType64 = 'sha256'
}

# Chocolatey can run a 32-bit PowerShell host on a 64-bit Windows installation,
# so do not use Get-OSArchitectureWidth as a suitability check here. The
# package contains 64-bit native builds and the release asset is selected from
# the host architecture variables instead.
$isArm64 = $env:PROCESSOR_ARCHITECTURE -eq 'ARM64' -or
  $env:PROCESSOR_ARCHITEW6432 -eq 'ARM64'

if ($isArm64) {
  $packageArgs.url64bit = 'https://github.com/dev-bhaskar8/gitside/releases/download/v__VERSION__/gitside-aarch64-pc-windows-msvc.zip'
  $packageArgs.checksum64 = '__ARM64_ZIP_SHA256__'
}

Install-ChocolateyZipPackage @packageArgs
